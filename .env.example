PORT=4000
GOOGLE_MAPS_API_KEY=your_key_here
# Geocoding + routes use the Maps APIs; typing suggestions need Places API (New) enabled on the same key.
DEFAULT_COUNTRY=Ghana
DEFAULT_COUNTRY_CODE=gh
# Optional: required for share links on Vercel/serverless (free tier at https://upstash.com)
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token
